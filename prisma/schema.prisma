generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LAWYER
  STAFF
}

enum ClientType {
  PERSON
  COMPANY
}

enum DossierType {
  CONTRACT
  DISPUTE
  REAL_ESTATE
  OTHER
}

enum DossierStatus {
  OPEN
  ON_HOLD
  CLOSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum DocumentType {
  LETTER
  CONTRACT
  NOTE
  OTHER
}

enum DocumentSource {
  TEMPLATE
  UPLOAD
  AI
}

enum AITrigger {
  NEW_DOC
  DASHBOARD_BRIEFING
  DEADLINE_SCAN
  USER_ASK
  SUMMARY
  SUGGEST_TASKS
  REVIEW_LATEST_DOC
}

enum AuditEntityType {
  CLIENT
  DOSSIER
  TASK
  DOCUMENT
  TIME_ENTRY
  TEMPLATE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  name             String
  passwordHash     String
  role             Role        @default(STAFF)
  createdAt        DateTime    @default(now())
  dossiersOwned    Dossier[]   @relation("DossierOwner")
  timeEntries      TimeEntry[]
  auditLogs        AuditLog[]  @relation("AuditActor")
}

model Client {
  id               String    @id @default(cuid())
  type             ClientType
  name             String
  email            String?
  phone            String?
  address          String?
  vatNumber        String?
  companyNumber    String?
  contactFirstName String?
  contactLastName  String?
  contactEmail     String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?
  dossiers         Dossier[]
}

model Dossier {
  id         String        @id @default(cuid())
  clientId   String
  title      String
  type       DossierType
  status     DossierStatus @default(OPEN)
  ownerUserId String
  summary    String?
  aiContext  String?
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?

  client     Client         @relation(fields: [clientId], references: [id])
  owner      User           @relation("DossierOwner", fields: [ownerUserId], references: [id])
  tasks      Task[]
  timeEntries TimeEntry[]
  documents  Document[]
  aiEvents   AIEvent[]

  @@index([clientId])
  @@index([ownerUserId])
}

model Task {
  id            String       @id @default(cuid())
  dossierId      String
  title         String
  description   String?
  deadline      DateTime?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  autoGenerated Boolean      @default(false)
  createdAt     DateTime     @default(now())

  dossier       Dossier      @relation(fields: [dossierId], references: [id])

  @@index([dossierId])
}

model TimeEntry {
  id           String    @id @default(cuid())
  dossierId    String
  userId       String
  startAt      DateTime
  endAt        DateTime?
  description  String
  autoCaptured Boolean   @default(false)
  createdAt    DateTime  @default(now())

  dossier      Dossier   @relation(fields: [dossierId], references: [id])
  user         User      @relation(fields: [userId], references: [id])

  @@index([dossierId])
  @@index([userId])
}

model Document {
  id         String         @id @default(cuid())
  dossierId  String
  type       DocumentType
  title      String
  content    String
  source     DocumentSource @default(UPLOAD)
  version    Int            @default(1)
  createdAt  DateTime       @default(now())

  dossier    Dossier        @relation(fields: [dossierId], references: [id])

  @@index([dossierId])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  type      String
  body      String
  createdAt DateTime @default(now())
}

model AIEvent {
  id           String    @id @default(cuid())
  dossierId    String
  trigger      AITrigger
  inputSummary String
  outputJson   String
  confidence   Float
  createdAt    DateTime  @default(now())

  dossier      Dossier   @relation(fields: [dossierId], references: [id])

  @@index([dossierId])
}

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId String?
  entityType  AuditEntityType
  entityId    String
  action      AuditAction
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime        @default(now())

  actor       User?           @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId])
}
